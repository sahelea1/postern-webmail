# Public host name of the webmail. Traefik requests the certificate for it.
POSTERN_HOST=webmail.example.com

# Names from your Traefik setup.
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Optional.
POSTERN_BRAND=Postern
POSTERN_SESSION_HOURS=168
POSTERN_MAX_UPLOAD_MB=25
POSTERN_ADMIN_PORT=8081
POSTERN_LOG=info
